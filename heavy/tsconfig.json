{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // `tests/ui/keys.ts` が `web/src/ui/Keypad/scientific` 経由で
    // `web/src/ui/Key/Key.tsx`(型だけ)に触れる。heavy に react は無いが、
    // これは型検査だけの依存で、react-jsx はそれを読めるようにするだけである。
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "tests",
    "harness",
    "vite.harness.config.ts",
    "vitest.config.ts",
    "playwright.corpus.config.ts",
    "playwright.ui.config.ts"
  ]
}
